# Core
PORT=3000
DB_PATH=./data/markets.sqlite
ADMIN_TOKEN=replace-with-a-long-random-value
API_TIMEOUT_MS=12000

# Property data providers (Workstream 1). Leave blank to use deterministic mock data.
ATTOM_API_KEY=
RENTCAST_API_KEY=
CENSUS_API_KEY=
# Force mock providers on/off (default: mock only when no provider keys are set)
MOCK_PROVIDERS=

# Permit portals (Workstream 2). Leave blank to use mock permits.
HILLSBOROUGH_SOCRATA_HOST=https://gis.hillsboroughcounty.org
HILLSBOROUGH_SOCRATA_DATASET=
SOCRATA_APP_TOKEN=
TAMPA_ARCGIS_URL=
MOCK_PERMITS=

# AI assistant & reporting (Workstream 3). Without a key a rules-based fallback is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BUILDER_NAME=Tampa Bay Custom Builders

# Cron schedules (optional overrides, standard cron syntax) used by `npm run cron`
CRON_MARKETS=0 3 * * 0
CRON_PROPERTIES=0 4 * * *
CRON_PERMITS=0 2 * * *
